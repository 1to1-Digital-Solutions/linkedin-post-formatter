{
  "name": "linkedin-post-formatter",
  "version": "0.1.0",
  "private": true,
  "description": "Bold, italic, strikethrough and more for LinkedIn posts, from Markdown or by hand. Runs entirely in the browser.",
  "license": "MIT",
  "homepage": "https://formato-linkedin.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/1to1-Digital-Solutions/formato-linkedin.git"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev -p 3400 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
