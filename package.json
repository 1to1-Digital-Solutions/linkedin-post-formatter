{
  "name": "formato-linkedin",
  "version": "0.1.0",
  "private": true,
  "description": "Da formato (negrita, cursiva, tachado…) al texto de un post de LinkedIn con caracteres Unicode, a partir de Markdown o a mano.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev -p 3400 -H 127.0.0.1",
